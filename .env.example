DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.anthropic.com/v1
OPENAI_MODEL=claude-opus-4-6
DATABASE_PATH=./data/sushii-agent.db

# Optional: enables the web_search tool (https://exa.ai)
EXA_API_KEY=

# Path to the per-guild config JSON file (default: ./guild-config.json). See
# src/guildConfig.ts for the full GuildConfig shape. Example guild-config.json:
# {
#   "123456789012345678": {
#     "allowedRoles": ["987654321098765432"],
#     "emojis": ["<:blobheart:123456789012345678>"],
#     "promptTemplate": "general",
#     "enabledModules": ["moderation", "wiki-sync"],
#     "wiki": { "statusChannelId": "234567890123456789" }
#   }
# }
# GUILD_CONFIG_PATH=./guild-config.json

# Optional: path to the manual cross-platform identity registry (default: ./principals.json).
# Maps a principal → its per-surface user ids. If the file is missing/empty, OWNER_DISCORD_ID is
# used to synthesize a single owner principal from it instead.
# PRINCIPALS_PATH=./principals.json

# Optional: path to the team grouping config (default: ./teams.json, falling back to the
# deprecated ./communities.json). See README's Configuration reference for the shape of an entry.
# TEAMS_PATH=./teams.json
